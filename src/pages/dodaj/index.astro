---
import Layout from "../../layouts/Layout.astro";
import { przedmioty } from "../../lib/catalog";
---

<Layout title="Dodaj notatkę — E-Notatki">
    <link
      slot="head"
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
    />

    <main class="page-shell formularz-notatki">
      <p>
        <a class="link-powrot" href="/Conspect/">
          ← Powrót do strony głównej
        </a>
      </p>

      <h1>Dodaj notatkę</h1>

      <p class="opis">
        Utwórz nową notatkę, dodaj zdjęcie lub skan i rozpoznaj tekst za pomocą
        OCR.
      </p>

      <form id="formularz-notatki">
        <p>
          <label for="tytul">Tytuł notatki</label>
          <br />
          <input
            id="tytul"
            name="tytul"
            type="text"
            placeholder="Np. Pole prostokątne"
            required
          />
        </p>

        <p>
          <label for="przedmiot">Przedmiot</label>
          <br />

          <select id="przedmiot" name="przedmiot" required>
            <option value="">Wybierz przedmiot</option>

            {przedmioty.map((przedmiot) => (
              <option value={przedmiot.nazwa}>{przedmiot.nazwa}</option>
            ))}
          </select>
        </p>

        <p>
          <label for="temat">Temat</label>
          <br />

          <input
            id="temat"
            name="temat"
            type="text"
            placeholder="Np. Pole prostokątne"
            required
          />
        </p>

        <p>
          <label for="data">Data</label>
          <br />

          <input id="data" name="data" type="date" required />
        </p>

        <p>
          <label for="tresc">Treść notatki</label>
        </p>

        <div class="przyciski-formatowania">
          <button id="przycisk-pogrubienie" type="button">
            Pogrubienie
          </button>

          <button id="przycisk-kursywa" type="button">
            Kursywa
          </button>

          <button id="przycisk-naglowek" type="button">
            Nagłówek
          </button>

          <button id="przycisk-lista" type="button">
            Lista
          </button>

          <button id="przycisk-tabela" type="button">
            Tabela
          </button>
        </div>
        <p>
          <textarea
            id="tresc"
            name="tresc"
            rows="20"
            placeholder="Wpisz treść notatki..."
            required
          ></textarea>
        </p>
        <div class="przyciski-formatowania">
          <button
            id="wyczysc-tresc-notatki"
            class="przycisk-usun-tresc"
            type="button"
          >
            🗑 Wyczyść treść notatki
          </button>
        </div>
        <p class="wybor-obrazu">
          <input
            id="obraz"
            class="input-pliku-ukryty"
            name="obraz"
            type="file"
            accept="image/*"
          />
          <label for="obraz" class="przycisk-wstaw-zdjecie">
            📷 Wstaw zdjęcie
          </label>
          <span id="nazwa-obrazu" class="nazwa-obrazu">
            Nie wybrano zdjęcia
          </span>
        </p>

        <p class="opis">
          Możesz też wkleić zrzut ekranu ze schowka skrótem Ctrl+V.
        </p>

        <p id="status-obrazu" role="status" aria-live="polite" hidden></p>

        <div id="podglad-obrazu-kontener" class="sekcja-ocr" hidden>
          <h3>Podgląd zdjęcia</h3>

          <img
            id="podglad-obrazu"
            class="podglad-obrazu"
            alt="Podgląd wybranego zdjęcia"
          />

          <fieldset class="wybor-trybu-ocr">
            <legend>Tryb rozpoznawania</legend>
            <div class="opcje-trybu-ocr">
              <label class="opcja-trybu-ocr">
                <input type="radio" name="tryb-ocr" value="2" checked />
                <span>
                  <strong>Szybki — tekst drukowany</strong>
                  <small>Do zwykłego drukowanego tekstu</small>
                </span>
              </label>
              <label class="opcja-trybu-ocr">
                <input type="radio" name="tryb-ocr" value="3" />
                <span>
                  <strong>Ręczne pismo</strong>
                  <small>Lepszy do odręcznych notatek, działa wolniej</small>
                </span>
              </label>
            </div>
          </fieldset>

          <p class="opis">
            OCR działa bez dodatkowego kodu. Zdjęcie i tekst wyślemy do Cloudflare Workers AI
            dopiero po kliknięciu przycisku poprawy przez AI.
          </p>

          <div class="przyciski-formatowania">
            <button id="usun-obraz" type="button">
              Usuń zdjęcie
            </button>

            <button id="przycisk-ocr" type="button">
              🔍 Rozpoznaj tekst ze zdjęcia
            </button>
          </div>
          <p
            id="status-ocr"
            class="status-ocr"
            role="status"
            aria-live="polite"
            hidden
          >
            ⏳ Trwa rozpoznawanie tekstu...
          </p>
        </div>

        <div id="wynik-ocr-kontener" class="sekcja-ocr" hidden>
          <h3>Tekst rozpoznany przez OCR</h3>
          <p class="opis">
            Możesz wstawić rozpoznany tekst od razu albo poprosić AI o poprawę i
            formatowanie. Przy poprawie zdjęcie oraz tekst zostaną wysłane do Cloudflare Workers AI.
          </p>

          <textarea
            id="wynik-ocr"
            rows="10"
            placeholder="Tutaj pojawi się rozpoznany tekst..."
          ></textarea>

          <p>
            <button id="przycisk-ai-ocr" type="button">
              ✨ Popraw tekst przez AI
            </button>
            <button
              id="wstaw-tekst-ocr"
              class="przycisk-wstaw-tekst"
              type="button"
            >
              ⬇️ Wstaw rozpoznany tekst
            </button>
            <button id="przywroc-tekst-ocr" type="button" hidden>
              ↶ Przywróć oryginalny OCR
            </button>
          </p>
          <p
            id="status-ai-ocr"
            class="status-ocr"
            role="status"
            aria-live="polite"
            hidden
          ></p>
        </div>

        <div id="kod-publikacji-kontener" hidden>
          <p>
            <label for="kod-publikacji">Kod dostępu do AI i publikacji</label>
            <br />
            <input
              id="kod-publikacji"
              type="password"
              autocomplete="current-password"
            />
          </p>
          <p
            id="status-kodu-publikacji"
            role="status"
            aria-live="polite"
            hidden
          ></p>
        </div>

        <div class="przyciski-formatowania">
          <button id="przycisk-podgladu" class="przycisk-glowny" type="button">
            Podgląd
          </button>

          <button id="przycisk-wyczysc" type="reset">
            Wyczyść formularz
          </button>

          <button class="przycisk-glowny" type="submit">
            Opublikuj notatkę
          </button>
        </div>
      </form>

      <section id="podglad" class="podglad" hidden>
        <hr />

        <h2>Podgląd notatki</h2>

        <p>
          <strong>Przedmiot:</strong>
          <span id="podglad-przedmiot"></span>
        </p>

        <p>
          <strong>Temat:</strong>
          <span id="podglad-temat"></span>
        </p>

        <p>
          <strong>Data:</strong>
          <span id="podglad-data"></span>
        </p>

        <h3>Treść</h3>

        <div id="podglad-tresc"></div>
      </section>
    </main>

    <script>
      import { marked } from "marked";
      import katex from "katex";

      const workerUrl =
        "https://luckconspect-ocry-recipe-ce50.andreutimofeev2008.workers.dev";

      const formularz = document.querySelector("#formularz-notatki");

      const przyciskPodgladu = document.querySelector("#przycisk-podgladu");

      const podglad = document.querySelector("#podglad");

      const przedmiot = document.querySelector("#przedmiot");

      const temat = document.querySelector("#temat");

      const data = document.querySelector("#data");

      const tresc = document.querySelector("#tresc");

      const obraz = document.querySelector("#obraz");

      const nazwaObrazu = document.querySelector("#nazwa-obrazu");

      const statusObrazu = document.querySelector("#status-obrazu");

      const podgladObrazuKontener = document.querySelector(
        "#podglad-obrazu-kontener",
      );

      const podgladObrazu = document.querySelector("#podglad-obrazu");

      let adresObrazu = null;

      const usunObraz = document.querySelector("#usun-obraz");

      const przyciskOcr = document.querySelector("#przycisk-ocr");

      const statusOcr = document.querySelector("#status-ocr");

      const przyciskAiOcr = document.querySelector("#przycisk-ai-ocr");

      const statusAiOcr = document.querySelector("#status-ai-ocr");

      const wynikOcrKontener = document.querySelector("#wynik-ocr-kontener");

      const wynikOcr = document.querySelector("#wynik-ocr");

      const wstawTekstOcr = document.querySelector("#wstaw-tekst-ocr");

      const przywrocTekstOcr = document.querySelector("#przywroc-tekst-ocr");

      const kodPublikacjiKontener = document.querySelector(
        "#kod-publikacji-kontener",
      );

      const kodPublikacjiInput = document.querySelector("#kod-publikacji");

      const statusKoduPublikacji = document.querySelector(
        "#status-kodu-publikacji",
      );

      let tekstOcrDoPrzywrocenia = null;

      let tekstPoAiOcr = null;

      let tekstOcrOryginalny = null;

      let kodPublikacjiAi = null;

      let akcjaPoKodzie = null;

      let plikOcrDlaAi = null;

      let jezykOcrDlaAi = "pol";

      function pokazPoleKoduPublikacji(akcja) {
        akcjaPoKodzie = akcja;
        kodPublikacjiKontener.hidden = false;
        statusKoduPublikacji.textContent =
          akcja === "ai"
            ? "Wpisz kod, a następnie ponownie kliknij „Popraw tekst przez AI”."
            : "Wpisz kod, a następnie ponownie kliknij „Opublikuj notatkę”.";
        statusKoduPublikacji.hidden = false;
        kodPublikacjiInput.focus();
      }

      function ukryjPoleKoduPublikacji() {
        akcjaPoKodzie = null;
        kodPublikacjiKontener.hidden = true;
        statusKoduPublikacji.hidden = true;
      }

      kodPublikacjiInput.addEventListener("keydown", (zdarzenie) => {
        if (zdarzenie.key !== "Enter") return;
        zdarzenie.preventDefault();

        if (akcjaPoKodzie === "ai") {
          przyciskAiOcr.click();
        } else if (akcjaPoKodzie === "publikacja") {
          formularz.requestSubmit();
        }
      });

      const przyciskPogrubienie = document.querySelector(
        "#przycisk-pogrubienie",
      );

      const przyciskKursywa = document.querySelector("#przycisk-kursywa");

      const przyciskNaglowek = document.querySelector("#przycisk-naglowek");

      const przyciskLista = document.querySelector("#przycisk-lista");

      const przyciskTabela = document.querySelector("#przycisk-tabela");

      function wstawFormatowanie(poczatek, koniec = "") {
        const start = tresc.selectionStart;
        const end = tresc.selectionEnd;

        const zaznaczonyTekst = tresc.value.slice(start, end);

        tresc.value =
          tresc.value.slice(0, start) +
          poczatek +
          zaznaczonyTekst +
          koniec +
          tresc.value.slice(end);

        tresc.focus();

        tresc.selectionStart = start + poczatek.length;

        tresc.selectionEnd = end + poczatek.length;
      }

      przyciskPogrubienie.addEventListener("click", () => {
        wstawFormatowanie("**", "**");
      });

      przyciskKursywa.addEventListener("click", () => {
        wstawFormatowanie("*", "*");
      });

      przyciskNaglowek.addEventListener("click", () => {
        wstawFormatowanie("## ");
      });

      przyciskLista.addEventListener("click", () => {
        wstawFormatowanie("- ");
      });

      przyciskTabela.addEventListener("click", () => {
        const tabela = `| Kolumna 1 | Kolumna 2 |
| --- | --- |
| Wartość 1 | Wartość 2 |
| Wartość 3 | Wartość 4 |`;

        const start = tresc.selectionStart;
        const koniec = tresc.selectionEnd;

        tresc.value =
          tresc.value.slice(0, start) + tabela + tresc.value.slice(koniec);

        tresc.focus();
      });

      function pokazPodgladObrazu(plik) {
        if (adresObrazu) {
          URL.revokeObjectURL(adresObrazu);
        }

        adresObrazu = URL.createObjectURL(plik);
        podgladObrazu.src = adresObrazu;
        nazwaObrazu.textContent = plik.name || "Wybrane zdjęcie";
        podgladObrazuKontener.hidden = false;
        wynikOcrKontener.hidden = true;
        wynikOcr.value = "";
        tekstOcrDoPrzywrocenia = null;
        tekstPoAiOcr = null;
        tekstOcrOryginalny = null;
        plikOcrDlaAi = null;
        wstawTekstOcr.textContent = "⬇️ Wstaw rozpoznany tekst";
        przyciskAiOcr.hidden = true;
        statusAiOcr.hidden = true;
        przywrocTekstOcr.hidden = true;
        statusObrazu.hidden = true;
      }

      obraz.addEventListener("change", () => {
        const plik = obraz.files[0];

        if (plik) {
          pokazPodgladObrazu(plik);
        }
      });

      document.addEventListener("paste", (zdarzenie) => {
        const elementObrazu = Array.from(
          zdarzenie.clipboardData?.items ?? [],
        ).find((element) => element.type.startsWith("image/"));

        const obrazZeSchowka = elementObrazu?.getAsFile();

        if (!obrazZeSchowka) {
          return;
        }

        zdarzenie.preventDefault();

        const typObrazu = obrazZeSchowka.type || "image/png";
        const rozszerzenie =
          typObrazu.split("/")[1]?.replace(/[^a-z0-9]/gi, "") || "png";
        const plik = new File(
          [obrazZeSchowka],
          `zrzut-ekranu.${rozszerzenie}`,
          { type: typObrazu },
        );
        const transfer = new DataTransfer();

        transfer.items.add(plik);
        obraz.files = transfer.files;
        obraz.dispatchEvent(new Event("change", { bubbles: true }));

        statusObrazu.textContent =
          "Zrzut ekranu wklejony. Możesz teraz rozpoznać tekst przez OCR.";
        statusObrazu.hidden = false;
      });

      usunObraz.addEventListener("click", () => {
        obraz.value = "";

        if (adresObrazu) {
          URL.revokeObjectURL(adresObrazu);
          adresObrazu = null;
        }

        podgladObrazu.src = "";
        nazwaObrazu.textContent = "Nie wybrano zdjęcia";

        podgladObrazuKontener.hidden = true;

        statusObrazu.hidden = true;

        wynikOcrKontener.hidden = true;

        wynikOcr.value = "";
        tekstOcrDoPrzywrocenia = null;
        tekstPoAiOcr = null;
        tekstOcrOryginalny = null;
        plikOcrDlaAi = null;
        wstawTekstOcr.textContent = "⬇️ Wstaw rozpoznany tekst";
        przyciskAiOcr.hidden = true;
        statusAiOcr.hidden = true;
        przywrocTekstOcr.hidden = true;
      });

      /*
       * OCR
       *
       * Obraz jest wysyłany do Cloudflare Worker.
       * Worker przekazuje go do OCR.space.
       */
      async function przygotujObrazDoOcr(plik) {
        const limit = 900_000;

        if (plik.size <= limit) return plik;

        statusOcr.hidden = false;
        statusOcr.textContent = "Optymalizacja dużego obrazu do wysłania…";

        let zrodlo;
        let adresTymczasowy;

        try {
          if (typeof createImageBitmap === "function") {
            zrodlo = await createImageBitmap(plik);
          } else {
            const obrazek = new Image();
            adresTymczasowy = URL.createObjectURL(plik);
            obrazek.src = adresTymczasowy;
            await obrazek.decode();
            zrodlo = obrazek;
          }

          const maksymalnyWymiar = 2200;
          let skala = Math.min(
            1,
            maksymalnyWymiar / Math.max(zrodlo.width, zrodlo.height),
          );
          let jakosc = 0.84;

          for (let proba = 0; proba < 8; proba += 1) {
            const szerokosc = Math.max(1, Math.round(zrodlo.width * skala));
            const wysokosc = Math.max(1, Math.round(zrodlo.height * skala));
            const plotno = document.createElement("canvas");
            plotno.width = szerokosc;
            plotno.height = wysokosc;

            const kontekst = plotno.getContext("2d");
            if (!kontekst)
              throw new Error("Nie można przygotować obrazu do OCR.");
            kontekst.drawImage(zrodlo, 0, 0, szerokosc, wysokosc);

            const blob = await new Promise((resolve) =>
              plotno.toBlob(resolve, "image/jpeg", jakosc),
            );
            if (!blob) throw new Error("Nie udało się skompresować obrazu.");

            if (blob.size <= limit) {
              const nazwa = plik.name.replace(/\.[^.]+$/, "") || "obraz";
              return new File([blob], `${nazwa}.jpg`, { type: "image/jpeg" });
            }

            if (proba % 2 === 0) {
              jakosc = Math.max(0.5, jakosc - 0.12);
            } else {
              skala *= 0.82;
            }
          }

          throw new Error(
            "Nie udało się zmniejszyć obrazu poniżej limitu OCR.space (1 MB). Wybierz mniejsze zdjęcie.",
          );
        } finally {
          if (typeof zrodlo?.close === "function") zrodlo.close();
          if (adresTymczasowy) URL.revokeObjectURL(adresTymczasowy);
        }
      }

      async function przygotujObrazDlaAi(plik) {
        const obslugiwaneTypy = [
          "image/jpeg",
          "image/png",
          "image/webp",
          "image/gif",
        ];

        if (obslugiwaneTypy.includes(plik.type)) return plik;

        let zrodlo;
        let adresTymczasowy;

        try {
          if (typeof createImageBitmap === "function") {
            zrodlo = await createImageBitmap(plik);
          } else {
            const obrazek = new Image();
            adresTymczasowy = URL.createObjectURL(plik);
            obrazek.src = adresTymczasowy;
            await obrazek.decode();
            zrodlo = obrazek;
          }

          const maksymalnyWymiar = 2200;
          let skala = Math.min(
            1,
            maksymalnyWymiar / Math.max(zrodlo.width, zrodlo.height),
          );
          let jakosc = 0.84;

          for (let proba = 0; proba < 8; proba += 1) {
            const szerokosc = Math.max(1, Math.round(zrodlo.width * skala));
            const wysokosc = Math.max(1, Math.round(zrodlo.height * skala));
            const plotno = document.createElement("canvas");
            plotno.width = szerokosc;
            plotno.height = wysokosc;

            const kontekst = plotno.getContext("2d");
            if (!kontekst)
              throw new Error("Nie można przygotować zdjęcia do poprawy AI.");
            kontekst.drawImage(zrodlo, 0, 0, szerokosc, wysokosc);

            const blob = await new Promise((resolve) =>
              plotno.toBlob(resolve, "image/jpeg", jakosc),
            );
            if (!blob)
              throw new Error("Nie udało się przygotować zdjęcia do poprawy AI.");

            if (blob.size <= 900_000) {
              const nazwa = plik.name.replace(/\.[^.]+$/, "") || "obraz";
              return new File([blob], `${nazwa}.jpg`, { type: "image/jpeg" });
            }

            if (proba % 2 === 0) {
              jakosc = Math.max(0.5, jakosc - 0.12);
            } else {
              skala *= 0.82;
            }
          }

          throw new Error("Nie udało się zmniejszyć zdjęcia do poprawy AI.");
        } finally {
          if (typeof zrodlo?.close === "function") zrodlo.close();
          if (adresTymczasowy) URL.revokeObjectURL(adresTymczasowy);
        }
      }

      przyciskOcr.addEventListener("click", async () => {
        const plik = obraz.files[0];

        if (!plik) {
          alert("Najpierw wybierz zdjęcie.");
          return;
        }

        statusOcr.hidden = false;
        statusOcr.textContent = "Wysyłanie obrazu do rozpoznawania…";
        statusOcr.classList.remove("status-ocr-blad");
        statusAiOcr.hidden = true;
        przyciskAiOcr.hidden = true;
        formularz
          .querySelectorAll("input, select, textarea, button")
          .forEach((element) => (element.disabled = true));
        wynikOcrKontener.hidden = true;
        wynikOcr.value = "";
        tekstOcrDoPrzywrocenia = null;
        tekstPoAiOcr = null;
        tekstOcrOryginalny = null;
        plikOcrDlaAi = null;
        wstawTekstOcr.textContent = "⬇️ Wstaw rozpoznany tekst";
        przywrocTekstOcr.hidden = true;

        try {
          const plikDoOcr = await przygotujObrazDoOcr(plik);
          const dane = new FormData();
          dane.append("file", plikDoOcr);

          let jezyk = "pol";
          if (przedmiot.value === "Język angielski") jezyk = "eng";
          if (przedmiot.value === "Język niemiecki") jezyk = "ger";
          dane.append("language", jezyk);
          const trybOcr =
            document.querySelector('input[name="tryb-ocr"]:checked')?.value ||
            "2";
          dane.append("engine", trybOcr);

          let odpowiedz;
          try {
            odpowiedz = await fetch(workerUrl + "/ocr", {
              method: "POST",
              body: dane,
            });
          } catch (blad) {
            if (blad instanceof TypeError) {
              throw new Error(
                "Błąd połączenia sieciowego. Sprawdź internet lub spróbuj przełączyć sieć.",
              );
            }
            throw blad;
          }

          const tekstOdpowiedzi = await odpowiedz.text();
          let wynik;

          try {
            wynik = JSON.parse(tekstOdpowiedzi);
          } catch {
            throw new Error(
              "Worker zwrócił nieprawidłową odpowiedź (HTTP " + odpowiedz.status + ").",
            );
          }

          if (!odpowiedz.ok) {
            const szczegoly =
              typeof wynik.details === "string"
                ? wynik.details
                : wynik.details
                  ? JSON.stringify(wynik.details)
                  : "";
            throw new Error(
              [
                wynik.error ||
                  "Serwer OCR zwrócił błąd HTTP " + odpowiedz.status + ".",
                szczegoly ? "Szczegóły: " + szczegoly : "",
              ]
                .filter(Boolean)
                .join(" "),
            );
          }

          if (wynik.result?.IsErroredOnProcessing) {
            const szczegoly = wynik.result?.ErrorMessage;
            throw new Error(
              Array.isArray(szczegoly)
                ? szczegoly.join(" ")
                : szczegoly || "OCR.space nie rozpoznał tego obrazu.",
            );
          }

          const tekst =
            wynik.result?.ParsedResults?.map(
              (element) => element.ParsedText,
            ).join("\n") || "";

          if (!tekst.trim()) {
            throw new Error("OCR nie rozpoznał tekstu na tym obrazie.");
          }

          wynikOcr.value = tekst;
          tekstOcrOryginalny = tekst;
          plikOcrDlaAi = plikDoOcr;
          jezykOcrDlaAi = jezyk;
          wynikOcrKontener.hidden = false;
          przyciskAiOcr.hidden = false;

          statusOcr.textContent =
            "OCR zakończony. Możesz wstawić tekst albo poprawić go przez AI.";
        } catch (blad) {
          console.error("Błąd OCR:", blad);
          const komunikat =
            blad instanceof Error ? blad.message : "Nieznany błąd OCR.";
          statusOcr.textContent = "Nie udało się rozpoznać tekstu. " + komunikat;
          statusOcr.classList.add("status-ocr-blad");
        } finally {
          formularz
            .querySelectorAll("input, select, textarea, button")
            .forEach((element) => (element.disabled = false));
        }
      });

      przyciskAiOcr.addEventListener("click", async () => {
        if (!plikOcrDlaAi || !tekstOcrOryginalny) return;

        const tekstDoPoprawy = wynikOcr.value.trim();
        if (!tekstDoPoprawy) {
          statusAiOcr.textContent = "Najpierw rozpoznaj tekst przez OCR.";
          statusAiOcr.hidden = false;
          statusAiOcr.classList.add("status-ocr-blad");
          return;
        }

        if (
          tresc.value.trim() &&
          !confirm(
            "Poprawiony tekst zastąpi całą obecną treść notatki. Kontynuować?",
          )
        ) {
          return;
        }

        let kodDoPoprawy = kodPublikacjiAi;
        if (!kodDoPoprawy) {
          kodDoPoprawy = kodPublikacjiInput.value.trim();
        }
        if (!kodDoPoprawy) {
          pokazPoleKoduPublikacji("ai");
          statusAiOcr.textContent =
            "Wpisz kod dostępu w polu na dole formularza. Po zatwierdzeniu wrócisz tutaj i uruchomisz poprawę.";
          statusAiOcr.hidden = false;
          return;
        }

        statusAiOcr.hidden = false;
        statusAiOcr.classList.remove("status-ocr-blad");
        statusAiOcr.textContent =
          "Wysyłanie zdjęcia i tekstu do Cloudflare Workers AI…";
        formularz
          .querySelectorAll("input, select, textarea, button")
          .forEach((element) => (element.disabled = true));

        try {
          const plikDlaAi = await przygotujObrazDlaAi(plikOcrDlaAi);
          const daneDoAi = new FormData();
          daneDoAi.append("file", plikDlaAi);
          daneDoAi.append("text", tekstDoPoprawy);
          daneDoAi.append("language", jezykOcrDlaAi);
          daneDoAi.append("kodPublikacji", kodDoPoprawy);

          let odpowiedzAi;
          try {
            odpowiedzAi = await fetch(workerUrl + "/format-ocr", {
              method: "POST",
              body: daneDoAi,
            });
          } catch (blad) {
            if (blad instanceof TypeError) {
              throw new Error("Nie udało się połączyć z usługą poprawy AI.");
            }
            throw blad;
          }

          const tekstOdpowiedziAi = await odpowiedzAi.text();
          let wynikAi;

          try {
            wynikAi = JSON.parse(tekstOdpowiedziAi);
          } catch {
            throw new Error(
              "Worker zwrócił nieprawidłową odpowiedź AI (HTTP " +
                odpowiedzAi.status +
                ").",
            );
          }

          if (!odpowiedzAi.ok) {
            if (odpowiedzAi.status === 401) {
              kodPublikacjiAi = null;
              kodPublikacjiInput.value = "";
              pokazPoleKoduPublikacji("ai");
              setTimeout(() => kodPublikacjiInput.focus(), 0);
            }

            const szczegoly = wynikAi.details;
            const diagnostyka =
              szczegoly && typeof szczegoly === "object"
                ? [
                    szczegoly.httpStatus && "HTTP " + szczegoly.httpStatus,
                    szczegoly.type,
                    szczegoly.code,
                    szczegoly.message,
                    szczegoly.requestId &&
                      "ID zapytania: " + szczegoly.requestId,
                  ]
                    .filter(Boolean)
                    .join("; ")
                : typeof szczegoly === "string"
                  ? szczegoly
                  : "";

            throw new Error(
              [
                wynikAi.error ||
                  "Usługa poprawy AI zwróciła błąd HTTP " +
                    odpowiedzAi.status +
                    ".",
                diagnostyka,
              ]
                .filter(Boolean)
                .join(" "),
            );
          }

          if (typeof wynikAi.text !== "string" || !wynikAi.text.trim()) {
            throw new Error("AI nie zwróciło poprawionego tekstu.");
          }

          const poprawionyTekst = wynikAi.text.trim();
          tekstOcrDoPrzywrocenia = tekstOcrOryginalny;
          tekstPoAiOcr = poprawionyTekst;
          kodPublikacjiAi = kodDoPoprawy;
          kodPublikacjiInput.value = "";
          ukryjPoleKoduPublikacji();
          wynikOcr.value = poprawionyTekst;
          tresc.value = poprawionyTekst;
          wstawTekstOcr.textContent = "⬇️ Wstaw poprawiony tekst";
          przywrocTekstOcr.hidden = false;
          statusAiOcr.textContent =
            "Tekst poprawiony i wstawiony do notatki. Oryginalny OCR możesz przywrócić przyciskiem poniżej.";
        } catch (blad) {
          console.error("Błąd poprawy tekstu przez AI:", blad);
          const komunikat =
            blad instanceof Error
              ? blad.message
              : "Nieznany błąd poprawy AI.";
          wynikOcr.value = tekstOcrOryginalny;
          tresc.value = tekstOcrOryginalny;
          tekstOcrDoPrzywrocenia = null;
          tekstPoAiOcr = null;
          wstawTekstOcr.textContent = "⬇️ Wstaw rozpoznany tekst";
          przywrocTekstOcr.hidden = true;
          statusAiOcr.textContent =
            "Nie udało się poprawić tekstu przez AI. Do notatki wstawiono tekst OCR. " +
            komunikat;
          statusAiOcr.classList.add("status-ocr-blad");
        } finally {
          formularz
            .querySelectorAll("input, select, textarea, button")
            .forEach((element) => (element.disabled = false));
        }
      });
      przywrocTekstOcr.addEventListener("click", () => {
        if (!tekstOcrDoPrzywrocenia) return;

        if (
          tresc.value !== tekstPoAiOcr &&
          !confirm(
            "Przywrócenie OCR zastąpi bieżące zmiany w notatce. Kontynuować?",
          )
        ) {
          return;
        }

        tresc.value = tekstOcrDoPrzywrocenia;
        wynikOcr.value = tekstOcrDoPrzywrocenia;
        tekstOcrDoPrzywrocenia = null;
        tekstPoAiOcr = null;
        wstawTekstOcr.textContent = "⬇️ Wstaw rozpoznany tekst";
        przywrocTekstOcr.hidden = true;
        statusAiOcr.textContent = "Przywrócono oryginalny tekst OCR.";
        tresc.focus();
      });
      wstawTekstOcr.addEventListener("click", () => {
        const tekst = wynikOcr.value.trim();

        if (!tekst) {
          return;
        }

        const start = tresc.selectionStart;

        const koniec = tresc.selectionEnd;

        tresc.value =
          tresc.value.slice(0, start) + tekst + tresc.value.slice(koniec);

        tresc.focus();

        tresc.selectionStart = start + tekst.length;

        tresc.selectionEnd = start + tekst.length;
      });

      const dzisiaj = new Date().toISOString().split("T")[0];

      data.value = dzisiaj;

      const podgladPrzedmiot = document.querySelector("#podglad-przedmiot");

      const podgladTemat = document.querySelector("#podglad-temat");

      const podgladData = document.querySelector("#podglad-data");

      const podgladTresc = document.querySelector("#podglad-tresc");

      const wyczyscTrescNotatki = document.querySelector(
        "#wyczysc-tresc-notatki",
      );

      wyczyscTrescNotatki.addEventListener("click", () => {
        if (!tresc.value || !confirm("Czy na pewno usunąć treść notatki?")) {
          return;
        }

        tresc.value = "";
        podglad.hidden = true;
        podgladTresc.textContent = "";
        tresc.focus();
      });

      przyciskPodgladu.addEventListener("click", () => {
        if (!podglad.hidden) {
          podglad.hidden = true;
          return;
        }

        if (!formularz.checkValidity()) {
          formularz.reportValidity();
          return;
        }

        podgladPrzedmiot.textContent = przedmiot.value;

        podgladTemat.textContent = temat.value;

        podgladData.textContent = data.value;

        let trescSformatowana = marked.parse(tresc.value);

        trescSformatowana = trescSformatowana.replace(
          /\$\$([\s\S]*?)\$\$/g,
          (_dopasowanie, formula) => {
            return katex.renderToString(formula.trim(), {
              displayMode: true,
              throwOnError: false,
            });
          },
        );

        podgladTresc.innerHTML = trescSformatowana;

        podglad.hidden = false;
      });

      formularz.addEventListener("submit", async (zdarzenie) => {
        zdarzenie.preventDefault();

        const tytul = document.querySelector("#tytul").value.trim();
        const przedmiot = document.querySelector("#przedmiot").value;
        const temat = document.querySelector("#temat").value.trim();
        const data = document.querySelector("#data").value;
        const tresc = document.querySelector("#tresc").value.trim();

        if (!tytul || !przedmiot || !temat || !data || !tresc) {
          alert("Uzupełnij wszystkie pola.");
          return;
        }

        const kodPublikacji =
          kodPublikacjiAi || kodPublikacjiInput.value.trim();

        if (!kodPublikacji) {
          pokazPoleKoduPublikacji("publikacja");
          return;
        }

        statusKoduPublikacji.textContent = "Trwa publikowanie notatki…";
        statusKoduPublikacji.hidden = false;

        try {
          const odpowiedz = await fetch(`${workerUrl}/publish`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              tytul,
              przedmiot,
              temat,
              data,
              tresc,
              kodPublikacji,
            }),
          });

          const wynik = await odpowiedz.json();

          if (!odpowiedz.ok) {
            if (odpowiedz.status === 401) {
              kodPublikacjiAi = null;
              kodPublikacjiInput.value = "";
              pokazPoleKoduPublikacji("publikacja");
            }
            statusKoduPublikacji.textContent =
              wynik.error || "Nie udało się opublikować notatki.";
            statusKoduPublikacji.hidden = false;
            return;
          }

          kodPublikacjiAi = kodPublikacji;
          kodPublikacjiInput.value = "";
          akcjaPoKodzie = null;
          statusKoduPublikacji.textContent =
            "Notatka została opublikowana pomyślnie.";
          statusKoduPublikacji.hidden = false;
        } catch (blad) {
          console.error(blad);
          statusKoduPublikacji.textContent =
            "Nie udało się połączyć z serwerem publikacji.";
          statusKoduPublikacji.hidden = false;
        }
      });
      formularz.addEventListener("reset", () => {
        setTimeout(() => {
          podglad.hidden = true;

          podgladObrazuKontener.hidden = true;

          wynikOcrKontener.hidden = true;

          if (adresObrazu) {
            URL.revokeObjectURL(adresObrazu);
            adresObrazu = null;
          }

          podgladObrazu.src = "";
          nazwaObrazu.textContent = "Nie wybrano zdjęcia";

          statusObrazu.hidden = true;

          wynikOcr.value = "";

          tekstOcrDoPrzywrocenia = null;
          tekstPoAiOcr = null;
          tekstOcrOryginalny = null;
          plikOcrDlaAi = null;
          kodPublikacjiAi = null;
          kodPublikacjiInput.value = "";
          ukryjPoleKoduPublikacji();
          przywrocTekstOcr.hidden = true;
          wstawTekstOcr.textContent = "⬇️ Wstaw rozpoznany tekst";
          przyciskAiOcr.hidden = true;
          statusAiOcr.hidden = true;

          statusOcr.hidden = true;

          data.value = dzisiaj;
        }, 0);
      });
    </script>
</Layout>
