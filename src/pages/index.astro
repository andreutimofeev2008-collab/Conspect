---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const notatki = await getCollection("notatki");

const ostatnieNotatki = notatki
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 5);

const przedmioty = [
  {
    slug: "pracownia-urzadzen-sieciowych",
    nazwa: "Pracownia urządzeń sieciowych",
  },
  {
    slug: "pracownia-urzadzen-techniki-komputerowej",
    nazwa: "Pracownia urządzeń techniki komputerowej",
  },
  {
    slug: "projektowanie-i-administrowanie-bazami-danych",
    nazwa: "Projektowanie i administrowanie bazami danych",
  },
  {
    slug: "jezyk-angielski",
    nazwa: "Język angielski",
  },
  {
    slug: "matematyka",
    nazwa: "Matematyka",
  },
  {
    slug: "fizyka",
    nazwa: "Fizyka",
  },
  {
    slug: "jezyk-niemiecki",
    nazwa: "Język niemiecki",
  },
  {
    slug: "edukacja-obywatelska",
    nazwa: "Edukacja obywatelska",
  },
  {
    slug: "geografia",
    nazwa: "Geografia",
  },
  {
    slug: "programowanie-i-obsluga-drukarek-3d",
    nazwa: "Programowanie i obsługa drukarek 3D",
  },
  {
    slug: "jezyk-polski",
    nazwa: "Język polski",
  },
  {
    slug: "chemia",
    nazwa: "Chemia",
  },
  {
    slug: "historia",
    nazwa: "Historia",
  },
];
---

<Layout title="E-Notatki">
    <main class="page-shell">
      <header class="naglowek-strony">
        <div>
          <p class="hero-kicker">Materiały od uczniów dla uczniów</p>
          <h1>E-Notatki</h1>

          <p>Wszystkie szkolne notatki w jednym, wygodnym miejscu.</p>
        </div>

        <a class="przycisk-glowny" href="/Conspect/dodaj/">
          Dodaj notatkę
        </a>
      </header>
      <div class="section-heading">
        <div>
          <p class="section-kicker">Zacznij od wyboru</p>
          <h2>Przedmioty</h2>
        </div>
        <span class="section-count">{przedmioty.length} przedmiotów</span>
      </div>

      <div class="subjects">
        {przedmioty.map((przedmiot) => (
          <a
            class="subject-card"
            href={`/Conspect/przedmioty/${przedmiot.slug}/`}
          >
            {przedmiot.nazwa}
          </a>
        ))}
      </div>
      <section class="ostatnie-notatki">
        <div class="section-heading">
          <div>
            <p class="section-kicker">Świeżo dodane</p>
            <h2>Ostatnie notatki</h2>
          </div>
          <span class="section-count">{notatki.length} łącznie</span>
        </div>

        <div class="notes-list">
          {ostatnieNotatki.length === 0 ? (
            <p class="empty-state">Brak opublikowanych notatek.</p>
          ) : (
            ostatnieNotatki.map((notatka) => (
              <a class="note-card" href={`/Conspect/notatki/${notatka.id}/`}>
                <strong>{notatka.data.tytul}</strong>

                <span class="note-subject">{notatka.data.przedmiot}</span>

                <span class="note-topic">{notatka.data.temat}</span>

                <span class="note-date">
                  {notatka.data.data.toLocaleDateString("pl-PL")}
                </span>
              </a>
            ))
          )}
        </div>
      </section>
    </main>
</Layout>
