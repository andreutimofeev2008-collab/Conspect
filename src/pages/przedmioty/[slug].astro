---
import { getCollection } from "astro:content";
import { przedmioty, grupyTytulow } from "../../lib/catalog";
import "../../styles/global.css";

export function getStaticPaths() {
  return przedmioty.map(({ slug, nazwa }) => ({
    params: { slug },
    props: { slug, nazwa },
  }));
}

const { slug, nazwa } = Astro.props;
const notatki = await getCollection("notatki");
const grupy = grupyTytulow(notatki, nazwa);
const liczbaNotatek = grupy.reduce(
  (suma, grupa) => suma + grupa.notatki.length,
  0,
);
---

<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{nazwa} — E-Notatki</title>
  </head>

  <body>
    <main>
      <section class="strona-przedmiotu">
        <p>
          <a class="link-powrot" href="/Conspect/">
            ← Powrót do strony głównej
          </a>
        </p>
        <h1>{nazwa}</h1>
        <p class="liczba-notatek">
          {liczbaNotatek} {liczbaNotatek === 1 ? "notatka" : "notatek"} w{" "}
          {grupy.length} {grupy.length === 1 ? "tytule" : "tytułach"}
        </p>

        <h2>Tytuły notatek</h2>
        {grupy.length > 0 ? (
          <div class="subjects">
            {grupy.map((grupa) => (
              <a
                class="subject-card"
                href={`/Conspect/przedmioty/${slug}/${grupa.slug}/`}
              >
                <strong>{grupa.tytul}</strong>
                <span class="note-topic">
                  {grupa.notatki.length}{" "}
                  {grupa.notatki.length === 1 ? "notatka" : "notatek"}
                </span>
              </a>
            ))}
          </div>
        ) : (
          <p>Na razie nie ma tutaj żadnych notatek.</p>
        )}
      </section>
    </main>
  </body>
</html>
